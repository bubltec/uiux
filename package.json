{
  "name": "@bubltec/uiux",
  "version": "0.0.0",
  "description": "Themeable UI components. The NES look is one theme; apps supply their own by setting the same tokens.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src/theme.css",
    "src/themes",
    "!dist/**/*.spec.*"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme.css": "./src/theme.css",
    "./themes/nes.css": "./src/themes/nes.css",
    "./themes/paw.css": "./src/themes/paw.css"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint -c .oxlintrc.json src",
    "test": "vitest run --exclude '**/dist/**'"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bubltec/uiux"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "27.0.1",
    "oxlint": "1.85.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@11.20.0"
}
